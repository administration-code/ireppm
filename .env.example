# Added automatically when Supabase is connected through Vercel (Storage tab).
# For local development, copy this file to .env.local and fill in the values
# from Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Supabase service-role key, used by /api/notify to look up listing
# and renter details. Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff email alerts (/api/notify) ---
# Resend API key (resend.com -> API Keys). The ireppm.ca domain must be verified
# in Resend so mail can be sent from alerts@ireppm.ca.
RESEND_API_KEY=
# Shared secret the Supabase database webhook sends in the "x-webhook-secret"
# header. Use a long random string, e.g. `openssl rand -hex 32`.
NOTIFY_WEBHOOK_SECRET=
# Who receives alerts. Separate several addresses with commas.
STAFF_ALERT_EMAIL=administration@ireppm.ca
# Shared secret the Gmail Apps Script sends in the "x-webhook-secret" header when
# it posts Interac e-Transfer deposits to /api/payments/interac.
PAYMENTS_WEBHOOK_SECRET=
